# ai-knowledge-rag 环境配置示例
# 复制为 .env 后填写真实值；.env 不提交仓库

# ---- 存储路径 ----
SQLITE_PATH=data/app.db
CHROMA_PATH=data/chroma

# ---- Embedding（SiliconFlow）----
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 检索 ----
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
FINAL_TOP_K=8
ROUTE_HEAD_RESERVE=1
MIN_DENSE_SIMILARITY=0.58
# Rerank：留空 API_BASE/API_KEY 时复用 Embedding 配置
RERANK_ENABLED=true
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=20
RERANK_TIMEOUT_S=20
RERANK_MAX_RETRIES=2

# ---- API 成本观测（单价未知时留空，不伪造费用）----
API_PROVIDER=siliconflow
API_COST_CURRENCY=CNY
EMBEDDING_INPUT_PRICE_PER_MILLION=
RERANK_INPUT_PRICE_PER_MILLION=
# 可选：滚动 24 小时预算；设置预算时必须同时配置相应单价
API_COST_BUDGET_24H=

# ---- 切块与上下文 ----
PARENT_MAX_CHARS=3000
CHILD_TARGET_CHARS=900
CHILD_MAX_CHARS=1000
CHILD_OVERLAP_CHARS=100
CONTEXT_BUDGET_CHARS=12000
CONTENT_PREVIEW_PARENT_LIMIT=20

# ---- 抓取 ----
FETCH_TIMEOUT_S=10
FETCH_MAX_RETRIES=1
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5
POLITE_DELAY_S=1.0
FETCH_USER_AGENT=ai-knowledge-rag/2.0.0 (+https://github.com/Rena-xie/ai_knowledge_RAG)
ROBOTS_CACHE_TTL_S=300

# ---- 外部调用 ----
EMBED_TIMEOUT_S=12
EMBED_MAX_RETRIES=1
# ---- 入库 ----
INGEST_TIMEOUT_S=60
INGEST_LOCK_TIMEOUT_S=30
# v2 异步入库：单次 URL 上限、待处理 job 上限、单 job 总预算（秒）
INGESTION_MAX_URLS=20
INGESTION_QUEUE_MAX=100
INGESTION_JOB_TIMEOUT_S=1800

# ---- 服务 ----
MAX_REQUEST_BYTES=1048576
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_FILE=data/logs/app.log
LOG_LEVEL=INFO
