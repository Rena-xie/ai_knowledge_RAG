# AI Knowledge Base 环境配置示例
# 复制为 .env 后填写真实值；.env 不提交仓库

# ---- 存储路径 ----
SQLITE_PATH=data/app.db
CHROMA_PATH=data/chroma

# ---- Embedding（SiliconFlow）----
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---- LLM（DeepSeek；deepseek-flash 已确认可用）----
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# ---- 检索 ----
DENSE_TOP_K=20
BM25_TOP_K=20
RRF_K=60
FINAL_TOP_K=8
ROUTE_HEAD_RESERVE=1
MIN_DENSE_SIMILARITY=0.58

# ---- 切块与上下文 ----
PARENT_MAX_CHARS=3000
CHILD_TARGET_CHARS=900
CHILD_MAX_CHARS=1000
CHILD_OVERLAP_CHARS=100
CONTEXT_BUDGET_CHARS=12000

# ---- 抓取 ----
FETCH_TIMEOUT_S=10
FETCH_MAX_RETRIES=1
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5
POLITE_DELAY_S=1.0
FETCH_USER_AGENT=ai-knowledge-base/v1 (+https://github.com/Rena-xie/ai_knowledge_RAG)
ROBOTS_CACHE_TTL_S=300

# ---- 外部调用 ----
EMBED_TIMEOUT_S=12
EMBED_MAX_RETRIES=1
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1

# ---- 入库 ----
INGEST_TIMEOUT_S=60
INGEST_LOCK_TIMEOUT_S=30

# ---- 服务 ----
MAX_REQUEST_BYTES=1048576
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_FILE=data/logs/app.log
LOG_LEVEL=INFO
